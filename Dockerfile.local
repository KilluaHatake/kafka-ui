FROM eclipse-temurin:25

RUN useradd -m -s /bin/bash kafkaui && \
    mkdir -p /etc/kafkaui && \
    chown -R kafkaui:kafkaui /etc/kafkaui

USER kafkaui

ARG JAR_FILE=api/build/libs/api-0.0.1-SNAPSHOT.jar
COPY ${JAR_FILE} /api.jar

ENV JAVA_OPTS=""
EXPOSE 8080

CMD ["sh", "-c", "java --add-opens java.rmi/javax.rmi.ssl=ALL-UNNAMED $JAVA_OPTS -jar /api.jar"]
